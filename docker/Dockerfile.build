# 우분투 22.04(Jammy) 기준 빌드 환경.
#
# PyInstaller가 만드는 바이너리는 "빌드한 머신의 glibc 버전 이상"인 곳에서만
# 실행된다(glibc는 하위 호환 - 새 버전에서 만들면 옛날 버전에서 못 돌아가지만,
# 그 반대는 된다). 라벨러들이 실제로 쓰는 가장 오래된 우분투가 22.04라서, 그보다
# 새 컴퓨터(24.04 등)에서도 다 돌아가게 하려면 22.04 환경에서 빌드해야 한다.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    # PyInstaller가 실행 파일에 넣을 libpython3.x.so를 찾으려면 -dev 패키지 필요
    # (venv의 python3만으로는 공유 라이브러리가 따로 없음)
    python3-dev \
    ffmpeg \
    # PySide6(Qt)/OpenCV가 빌드(freeze) 과정에서 공유 라이브러리를 로드하려면 필요
    libgl1 libegl1 libxkbcommon0 libdbus-1-3 \
    # Qt의 xcb(X11 화면 표시) 플랫폼 플러그인이 쓰는 라이브러리들 - 최소 설치
    # 이미지엔 없어서 PyInstaller가 "Library not found"로 번들에서 빠뜨렸었음.
    # 여기 설치해두면 PyInstaller가 찾아서 실행 파일에 같이 담아주므로, 배포
    # 대상 PC에 이 라이브러리들이 없어도 동작한다.
    libxcb-icccm4 libxkbcommon-x11-0 libxcb-image0 \
    libxcb-render-util0 libxcb-keysyms1 libxcb-randr0 libxcb-shape0 \
    libxcb-xinerama0 libxcb-cursor0 libice6 libsm6 \
    # GTK 테마 연동 플러그인(libqgtk3.so)용 - 없어도 동작엔 지장 없지만(기본
    # 스타일로 대체) 있으면 GTK 데스크톱에서 더 자연스러운 위젯 모양이 됨
    libgtk-3-0 libatk1.0-0 \
    # PyInstaller가 리눅스에서 바이너리 분석에 objdump(binutils)를 요구함
    binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
